# THE VOID — Environment Configuration

# Server Port and Host
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database Configuration
# Option 1: External PostgreSQL (Production / Docker Compose)
# DATABASE_URL=postgresql://void_user:void_password@localhost:5432/thevoid
# Option 2: Embedded Persistent PostgreSQL on disk via PGlite (Default when DATABASE_URL is unset)
PGLITE_DATA_DIR=./data/pgdata

# Optional initial seed object at (0, 0) when database is empty
SEED_INITIAL_OBJECT=true

# Security & CORS Origins (comma-separated or * for public world)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Infrastructure Protection & Resource Limits
MAX_HTML_BYTES=65536
MAX_CSS_BYTES=65536
MAX_JS_BYTES=65536
MAX_PAYLOAD_BYTES=262144
MAX_WS_MESSAGE_BYTES=262144
MAX_OBJECTS_PER_REGION_QUERY=250
MAX_REVISIONS_PER_OBJECT=100
RATE_LIMIT_HTTP_MAX=300
RATE_LIMIT_HTTP_WINDOW_MS=60000
RATE_LIMIT_MUTATIONS_PER_MIN=120
RATE_LIMIT_CREATES_PER_MIN=40
RATE_LIMIT_DELETES_PER_MIN=60
MAX_WS_CONNECTIONS_PER_IP=50
MAX_TOTAL_WS_CONNECTIONS=2000
